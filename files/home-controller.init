#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 enabled=$(jsonfilter -i /etc/home-controller/config.json -e '@.enabled')
 [ "$enabled" = true ] || return 0
 /usr/bin/home-controller configure || return 1
 /etc/init.d/telldusd restart || return 1
 procd_open_instance backend
 procd_set_param command /usr/bin/home-controller serve
 procd_set_param user homecontroller
 procd_set_param group homecontroller
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits core="0" nofile="256"
 procd_close_instance
 procd_open_instance web
 # File contains only program-generated, quoted arguments.
 procd_set_param command /bin/sh -c 'eval "exec /usr/sbin/uhttpd $(cat /var/run/home-controller/uhttpd.args)"'
 procd_set_param user homecontroller
 procd_set_param group homecontroller
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits core="0" nofile="256"
 procd_close_instance
}
reload_service() { restart; }
service_triggers() { procd_add_reload_trigger home_controller network firewall; }

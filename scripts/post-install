#!/bin/sh
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
. /lib/functions.sh
group_id=$(group_add_next homecontroller)
user_exists homecontroller || user_add homecontroller '' "$group_id" 'Home Controller' /var/run/home-controller /bin/false
mkdir -p /etc/home-controller/state /var/run/home-controller
chown root:homecontroller /etc/home-controller
chmod 750 /etc/home-controller
chown homecontroller:homecontroller /etc/home-controller/state /var/run/home-controller
chmod 700 /etc/home-controller/state /var/run/home-controller
chown root:homecontroller /etc/home-controller/config.json
chmod 640 /etc/home-controller/config.json
if [ -f /etc/home-controller/credential.json ]; then
 chown root:homecontroller /etc/home-controller/credential.json
 chmod 640 /etc/home-controller/credential.json
fi
chown root:homecontroller /etc/home-controller/tls.* 2>/dev/null || true
chmod 640 /etc/home-controller/tls.* 2>/dev/null || true
/etc/init.d/rpcd restart
/etc/init.d/home-controller enable
rm -f /tmp/luci-indexcache.*.json
if [ "$(jsonfilter -i /etc/home-controller/config.json -e '@.enabled')" = true ]; then /etc/init.d/home-controller start || exit 1; fi
exit 0
